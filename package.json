{
  "name": "sastika-mobiles",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "frontend": "vite --host",
    "backend": "npm --prefix server run dev",
    "client": "vite --host",
    "server": "npm --prefix server run dev",
    "dev:frontend": "vite --host",
    "dev:backend": "npm --prefix server run dev",
    "dev:all": "concurrently -n \"frontend,backend\" -c \"cyan,green\" \"npm run frontend\" \"npm run backend\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "seed": "npm --prefix server run seed",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:logs": "pm2 logs sastika-backend"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.5.4",
    "vite": "^8.3.5"
  }
}
